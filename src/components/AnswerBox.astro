---
/**
 * Bloc « réponse directe » placé en haut de page.
 *
 * Objectif GEO : fournir un paragraphe autoportant, factuel et citable,
 * que les moteurs génératifs peuvent extraire tel quel. Il est volontairement
 * placé juste après le H1, en texte brut et sans dépendance au contexte visuel.
 */
import Icon from './Icon.astro';

interface Props {
  question: string;
  /** Liste de faits vérifiables : prix, délais, volumes, zone. */
  facts?: { label: string; value: string }[];
  class?: string;
}

const { question, facts = [], class: className = '' } = Astro.props;
---

<div
  class={`rounded-card border border-ink-200 bg-ink-50/70 p-6 lg:p-8 ${className}`}
  data-answer-block
>
  <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-benne-700">
    <Icon name="check" size={16} />
    En bref
  </p>
  <h2 class="mt-3 text-lg font-bold text-ink-950 lg:text-xl">{question}</h2>
  <div class="mt-3 text-[1.02rem] leading-relaxed text-ink-700">
    <slot />
  </div>

  {
    facts.length > 0 && (
      <dl class="mt-6 grid gap-4 border-t border-ink-200 pt-5 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((fact) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">{fact.label}</dt>
            <dd class="mt-1 font-display text-lg font-bold text-ink-950">{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
