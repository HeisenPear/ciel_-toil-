---
// Section contact — formulaire de devis + lien WhatsApp direct
// Formspree (option 1, activée par défaut) ou Netlify Forms (option 2, en commentaire)
---

<section id="contact" class="py-28 px-4 bg-surface">
  <div class="max-w-2xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <p class="font-body text-gold text-xs tracking-[0.4em] uppercase mb-5">Prêt à transformer votre voiture ?</p>
      <h2 class="font-display text-5xl md:text-6xl text-warm-white mb-4">Demandez un devis</h2>
      <p class="font-body text-warm-white/45 text-sm">Gratuit &amp; sans engagement · Réponse sous 24 h</p>
      <span class="section-rule mt-6"></span>
    </div>

    <!--
      OPTION 1 — Formspree (défaut)
      Remplacer VOTRE_FORM_ID par votre ID Formspree (ex: xpwzlqkr)
    -->
    <form
      action="https://formspree.io/f/VOTRE_FORM_ID"
      method="POST"
      class="space-y-6 reveal reveal-delay-1"
    >

    <!--
      OPTION 2 — Netlify Forms
      Supprimer le form ci-dessus et décommenter :
    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="space-y-6 reveal reveal-delay-1"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>Ne pas remplir : <input name="bot-field" /></label></p>
    -->

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="form-group">
          <label for="name" class="form-label">Nom complet</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            placeholder="Jean Dupont"
            class="form-input"
          />
        </div>
        <div class="form-group">
          <label for="phone" class="form-label">Téléphone</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            autocomplete="tel"
            placeholder="+33 6 XX XX XX XX"
            class="form-input"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="vehicle" class="form-label">Votre véhicule</label>
        <input
          type="text"
          id="vehicle"
          name="vehicle"
          required
          placeholder="Ex : BMW M3 2022, Porsche 911 Carrera, Audi RS6…"
          class="form-input"
        />
      </div>

      <div class="form-group">
        <label for="service" class="form-label">Prestation souhaitée</label>
        <select id="service" name="service" required class="form-input">
          <option value="" disabled selected>Sélectionnez une prestation</option>
          <option value="ciel-etoile">Ciel étoilé fibre optique</option>
          <option value="carplay">Intégration CarPlay / Android Auto</option>
          <option value="les-deux">Les deux prestations</option>
          <option value="autre">Autre / Je ne sais pas encore</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message" class="form-label">Message (optionnel)</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Décrivez votre projet, vos attentes, la couleur souhaitée…"
          class="form-input resize-none"
        ></textarea>
      </div>

      <button type="submit" class="btn-shimmer w-full py-4 text-xs flex items-center justify-center gap-3">
        Envoyer ma demande de devis
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </form>

    <!-- Séparateur -->
    <div class="flex items-center gap-4 my-10 reveal reveal-delay-2">
      <div class="flex-1 h-px bg-white/8"></div>
      <span class="font-body text-warm-white/30 text-xs tracking-widest uppercase">ou</span>
      <div class="flex-1 h-px bg-white/8"></div>
    </div>

    <!-- WhatsApp direct -->
    <div class="text-center reveal reveal-delay-3">
      <p class="font-body text-warm-white/40 text-xs tracking-wider mb-5 uppercase">Contactez-nous directement sur WhatsApp</p>
      <a
        href="https://wa.me/33600000000?text=Bonjour%2C%20je%20souhaite%20un%20devis%20pour%20ma%20voiture.%20Mod%C3%A8le%20%3A%20"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#075E54] hover:bg-[#128C7E] px-7 py-3.5 transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="font-body text-white text-sm font-medium">+33 6 XX XX XX XX</span>
      </a>
    </div>

  </div>
</section>
