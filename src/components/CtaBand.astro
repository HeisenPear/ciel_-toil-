---
import { CONTACT } from '../config/site';
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Besoin d’une benne cette semaine ?',
  text = 'Devis ferme sous 2 h ouvrées, livraison sous 24 à 48 h sur Tours et l’Indre-et-Loire.',
} = Astro.props;
---

<section class="bg-benne-500" aria-labelledby="cta-band-title">
  <div class="hazard-stripes h-2" aria-hidden="true"></div>
  <div class="container-page py-12 lg:py-14">
    <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 id="cta-band-title" class="text-2xl font-bold text-ink-950 lg:text-3xl">
          {title}
        </h2>
        <p class="mt-2 text-ink-900/85">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href="/contact" variant="dark" size="lg" iconAfter="arrow-right">
          Demander un devis gratuit
        </Button>
        <a
          href={`tel:${CONTACT.phoneE164}`}
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink-950 px-7 py-3.5 font-semibold text-ink-950 transition-colors hover:bg-ink-950 hover:text-white"
        >
          <Icon name="phone" size={20} />
          {CONTACT.phone}
        </a>
      </div>
    </div>
  </div>
</section>
