---
import { CONTACT } from '../config/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
import BenneIllustration from './BenneIllustration.astro';

interface Props {
  title: string;
  /** Paragraphe d'accroche : première phrase autoportante pour l'extraction. */
  lead: string;
  eyebrow?: string;
  points?: string[];
  primaryCta?: { label: string; href: string };
}

const {
  title,
  lead,
  eyebrow = 'Tours · Indre-et-Loire (37)',
  points = [
    'Livraison sous 24 à 48 h',
    'Tarif tout compris, sans frais caché',
    'Déchets triés et valorisés en centre agréé',
  ],
  primaryCta = { label: 'Ou écrivez-nous', href: '/contact' },
} = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <!-- Trame technique discrète, sans image à télécharger -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 56px 56px;"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-benne-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-16 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-benne-500/40 bg-benne-500/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-benne-300"
        >
          <Icon name="pin" size={14} />
          {eyebrow}
        </p>

        <h1 class="mt-6 text-4xl leading-[1.08] text-white sm:text-5xl lg:text-[3.4rem]">
          {title}
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">{lead}</p>

        <ul class="mt-8 space-y-3">
          {
            points.map((point) => (
              <li class="flex items-start gap-3 text-ink-200">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-benne-500 text-ink-950">
                  <Icon name="check" size={14} />
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={`tel:${CONTACT.phoneE164}`}
            class="inline-flex items-center justify-center gap-3 rounded-full bg-benne-500 px-8 py-4 font-display text-xl font-bold text-ink-950 shadow-[0_14px_32px_-14px_rgba(242,164,19,0.95)] transition-transform hover:-translate-y-0.5"
            data-appel="hero"
          >
            <Icon name="phone" size={24} />
            {CONTACT.phone}
          </a>
          <Button href={primaryCta.href} variant="outline" size="lg" class="!border-ink-700 !text-white hover:!bg-ink-900">
            {primaryCta.label}
          </Button>
        </div>

        <p class="mt-4 text-sm text-ink-400">
          Un doute sur le volume, l’accès ou le délai ? Un appel de deux minutes suffit
          à tout caler. Devis établi dans la foulée.
        </p>
      </div>

      <div class="relative">
        <BenneIllustration class="w-full drop-shadow-2xl" />
        <div
          class="mt-6 grid grid-cols-3 divide-x divide-ink-800 rounded-card border border-ink-800 bg-ink-900/70 text-center"
        >
          <div class="px-3 py-5">
            <p class="font-display text-2xl font-bold text-benne-400">24-48 h</p>
            <p class="mt-1 text-xs text-ink-400">Délai de livraison</p>
          </div>
          <div class="px-3 py-5">
            <p class="font-display text-2xl font-bold text-benne-400">272</p>
            <p class="mt-1 text-xs text-ink-400">Communes desservies</p>
          </div>
          <div class="px-3 py-5">
            <p class="font-display text-2xl font-bold text-benne-400">1 à 30 m³</p>
            <p class="mt-1 text-xs text-ink-400">Volumes disponibles</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hazard-stripes h-2" aria-hidden="true"></div>
</section>
