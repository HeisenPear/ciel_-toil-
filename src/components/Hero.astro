---
// Hero plein écran — photo ciel étoilé, overlay, étoiles CSS animées, CTA principal
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero-ciel-etoile.jpg';
---

<section
  class="hero relative w-full min-h-screen flex items-center justify-center overflow-hidden"
  aria-label="Section principale"
>
  <!-- Background photo (optimisée Astro) -->
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImg}
      alt="Ciel étoilé fibre optique violet avec étoiles filantes dans un habitacle automobile"
      class="w-full h-full object-cover object-center"
      width={1920}
      height={1080}
      quality={85}
      loading="eager"
      decoding="async"
    />
    <!-- Gradient overlay — assombrit pour lisibilité du texte -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink/75 via-ink/50 to-ink/88"></div>
    <!-- Vignette latérale -->
    <div class="absolute inset-0 bg-gradient-to-r from-ink/40 via-transparent to-ink/40"></div>
  </div>

  <!-- Starfield CSS overlay -->
  <div class="absolute inset-0 z-10 pointer-events-none" id="hero-stars" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-20 text-center px-4 max-w-5xl mx-auto pt-20">

    <!-- Eyebrow -->
    <p
      class="font-body text-gold text-xs tracking-[0.4em] uppercase mb-8 opacity-0 animate-[fadeDown_0.8s_0.3s_forwards]"
    >
      Artisan automobile &nbsp;·&nbsp; Sur mesure
    </p>

    <!-- Headline -->
    <h1
      class="font-display text-6xl sm:text-7xl md:text-8xl lg:text-[7rem] text-warm-white leading-[0.92] mb-8 opacity-0 animate-[fadeDown_0.9s_0.55s_forwards]"
    >
      Votre voiture.<br />
      <em class="text-champagne italic font-light">Un autre univers.</em>
    </h1>

    <!-- Subline -->
    <p
      class="font-body text-base md:text-lg text-warm-white/65 max-w-xl mx-auto mb-12 leading-relaxed opacity-0 animate-[fadeDown_0.8s_0.8s_forwards]"
    >
      Ciel étoilé fibre optique &amp; intégration CarPlay/Android Auto.<br />
      Chaque réalisation est unique, pensée pour votre véhicule.
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0 animate-[fadeDown_0.8s_1s_forwards]"
    >
      <a
        href="#contact"
        class="btn-shimmer px-9 py-4 text-xs inline-flex items-center gap-3"
      >
        Demander un devis gratuit
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a
        href="#galerie"
        class="font-body text-warm-white/60 hover:text-warm-white text-xs tracking-[0.2em] uppercase transition-colors duration-200 inline-flex items-center gap-2"
      >
        <span>Voir les réalisations</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 opacity-0 animate-[fadeDown_0.6s_1.5s_forwards]">
    <div class="w-px h-14 bg-gradient-to-b from-gold/0 via-gold/70 to-gold/0 animate-pulse"></div>
  </div>
</section>

<style>
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Génère le champ d'étoiles CSS de façon aléatoire
  const container = document.getElementById('hero-stars');
  if (!container) throw new Error();

  const count = window.innerWidth < 768 ? 120 : 200;

  for (let i = 0; i < count; i++) {
    const star = document.createElement('span');
    const size = Math.random() * 2.4 + 0.4;
    star.style.cssText = [
      'position:absolute',
      `width:${size}px`,
      `height:${size}px`,
      `left:${Math.random() * 100}%`,
      `top:${Math.random() * 100}%`,
      'background:white',
      'border-radius:50%',
      `animation:twinkle ${2 + Math.random() * 5}s ${Math.random() * 6}s ease-in-out infinite`,
      'will-change:opacity,transform',
    ].join(';');
    container.appendChild(star);
  }

  // Quelques étoiles filantes
  for (let i = 0; i < 4; i++) {
    const s = document.createElement('span');
    const delay = 1.5 + i * 3.2 + Math.random() * 2;
    s.style.cssText = [
      'position:absolute',
      `left:${10 + Math.random() * 55}%`,
      `top:${5 + Math.random() * 35}%`,
      'width:70px',
      'height:1px',
      'background:linear-gradient(90deg,transparent,rgba(255,255,255,0.9),transparent)',
      `animation:shooting-star 1.8s ${delay}s ease-out infinite`,
      'transform-origin:left center',
      `transform:rotate(${-15 - Math.random() * 20}deg)`,
      'opacity:0',
    ].join(';');
    container.appendChild(s);
  }
</script>
