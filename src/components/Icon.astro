---
/**
 * Jeu d'icônes en SVG inline (stroke 1.75, grille 24).
 * Inline plutôt que sprite : quelques Ko économisés et zéro requête réseau.
 */
export type IconName =
  | 'truck'
  | 'euro'
  | 'map'
  | 'recycle'
  | 'phone'
  | 'mail'
  | 'clock'
  | 'check'
  | 'arrow-right'
  | 'chevron-down'
  | 'ruler'
  | 'weight'
  | 'warning'
  | 'building'
  | 'home'
  | 'leaf'
  | 'hammer'
  | 'box'
  | 'shield'
  | 'calendar'
  | 'pin'
  | 'menu'
  | 'close'
  | 'ban';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;

const paths: Record<IconName, string> = {
  truck:
    '<path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-7z"/><circle cx="6.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>',
  euro: '<path d="M17 5.5A6.5 6.5 0 0 0 7.2 11m0 2A6.5 6.5 0 0 0 17 18.5"/><path d="M4 10h8"/><path d="M4 14h8"/>',
  map: '<path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14"/><path d="M15 6v14"/>',
  recycle:
    '<path d="M7 19H5a2 2 0 0 1-1.7-3l1.6-2.7"/><path d="m8.5 4.5 1.8 3.1"/><path d="M12 3.5 10 7h4z" fill="currentColor" stroke="none"/><path d="M17 19h2a2 2 0 0 0 1.7-3L16 7.5"/><path d="M7 19h8"/><path d="m9 16.5-2 2.5 2 2.5"/><path d="M4.9 13.3 9 6.2"/>',
  phone:
    '<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 6.2 2 2 0 0 1 6 4z"/>',
  mail: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  check: '<path d="m4 12.5 5 5L20 6.5"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  ruler: '<path d="m3 15 6-6 6 6-6 6z" transform="rotate(45 12 12)"/><path d="M8 10.5 9.5 12"/><path d="M11 8l1.5 1.5"/><path d="M14 5.5 15.5 7"/>',
  weight: '<path d="M5 8h14l1.5 12h-17z"/><circle cx="12" cy="5" r="2.5"/>',
  warning: '<path d="M12 3.5 22 20H2z"/><path d="M12 9.5v5"/><path d="M12 17.5h.01"/>',
  building:
    '<path d="M4 21V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v16"/><path d="M15 9h3a2 2 0 0 1 2 2v10"/><path d="M8 7h3"/><path d="M8 11h3"/><path d="M8 15h3"/><path d="M2 21h20"/>',
  home: '<path d="m3 10.5 9-7 9 7V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
  leaf: '<path d="M4 20c0-8 5-14 16-14 0 10-5 15-12 15a4 4 0 0 1-4-1z"/><path d="M9.5 15c1.5-3 4-5.5 7-7"/>',
  hammer:
    '<path d="m13.5 6.5 4-4 4 4-4 4z"/><path d="m12 8 4 4"/><path d="M14.5 10.5 6 19a2.1 2.1 0 0 1-3-3l8.5-8.5"/>',
  box: '<path d="m12 3 8.5 4.5v9L12 21l-8.5-4.5v-9z"/><path d="m3.5 7.5 8.5 4.5 8.5-4.5"/><path d="M12 12v9"/>',
  shield: '<path d="M12 3l7.5 3v6c0 4.5-3 7.8-7.5 9-4.5-1.2-7.5-4.5-7.5-9V6z"/><path d="m9 12 2 2 4-4"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M8 3v4"/><path d="M16 3v4"/>',
  pin: '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="m6 6 12 12"/><path d="m18 6-12 12"/>',
  ban: '<circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
