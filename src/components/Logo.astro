---
interface Props {
  class?: string;
  /** Variante claire pour les fonds sombres. */
  light?: boolean;
}
const { class: className = '', light = false } = Astro.props;

const textColor = light ? '#FFFFFF' : '#0F1622';
const subColor = light ? '#A6B4C9' : '#556C8D';
---

<svg
  class={className}
  viewBox="0 0 240 48"
  role="img"
  aria-label="Benne Express 37"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Silhouette de benne ampliroll vue de profil -->
  <g fill="none" stroke-linejoin="round" stroke-linecap="round">
    <path d="M4 34 L10 12 H42 L46 34 Z" fill="#F2A413" />
    <path d="M4 34 L10 12 H42 L46 34 Z" stroke={textColor} stroke-width="2.5" />
    <path d="M13 20 H39" stroke={textColor} stroke-width="2" opacity="0.55" />
    <path d="M11.5 27 H41" stroke={textColor} stroke-width="2" opacity="0.55" />
    <path d="M2 37 H48" stroke={textColor} stroke-width="3" />
  </g>
  <text
    x="58"
    y="26"
    font-family="Archivo, ui-sans-serif, system-ui, sans-serif"
    font-size="21"
    font-weight="800"
    letter-spacing="-0.6"
    fill={textColor}>BENNE EXPRESS</text
  >
  <text
    x="58"
    y="40"
    font-family="Inter, ui-sans-serif, system-ui, sans-serif"
    font-size="11.5"
    font-weight="600"
    letter-spacing="3.4"
    fill={subColor}>INDRE-ET-LOIRE 37</text
  >
</svg>
