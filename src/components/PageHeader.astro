---
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  breadcrumbs: { name: string; url: string }[];
  /** Chiffres clés affichés sous le titre. */
  stats?: { label: string; value: string }[];
}

const { title, lead, eyebrow, breadcrumbs, stats = [] } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.06]"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px;"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-benne-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative py-10 lg:py-14">
    <Breadcrumbs items={breadcrumbs} tone="dark" />

    {
      eyebrow && (
        <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-benne-500/40 bg-benne-500/10 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-benne-300">
          <Icon name="pin" size={14} />
          {eyebrow}
        </p>
      )
    }

    <h1 class="mt-5 max-w-4xl text-3xl leading-[1.12] text-white sm:text-4xl lg:text-[3rem]">
      {title}
    </h1>

    {lead && <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-300">{lead}</p>}

    {
      stats.length > 0 && (
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          {stats.map((stat) => (
            <div>
              <dt class="text-xs uppercase tracking-wide text-ink-400">{stat.label}</dt>
              <dd class="mt-1 font-display text-2xl font-bold text-benne-400">{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>

  <div class="hazard-stripes h-1.5" aria-hidden="true"></div>
</section>
