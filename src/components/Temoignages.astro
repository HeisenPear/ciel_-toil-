---
// Section témoignages — 3 avis clients crédibles avec note et contexte véhicule
const reviews = [
  {
    name: 'Alexandre M.',
    city: 'Lyon',
    service: 'Ciel étoilé — BMW M3',
    rating: 5,
    text: "Résultat bluffant sur ma M3. L'ambiance la nuit est incomparable, on se croirait dans un jet privé. Travail soigné, ponctuel et sans trace aucune. Je recommande les yeux fermés.",
    initials: 'AM',
  },
  {
    name: 'Sarah K.',
    city: 'Paris',
    service: 'Ciel étoilé — Porsche Macan',
    rating: 5,
    text: "J'avais des doutes sur le rendu final, mais les photos ne rendent vraiment pas justice à l'effet en vrai. Mes passagères sont stupéfaites à chaque trajet. Un luxe accessible.",
    initials: 'SK',
  },
  {
    name: 'Thomas R.',
    city: 'Annecy',
    service: 'CarPlay — Porsche Cayman',
    rating: 5,
    text: "Mon Cayman a retrouvé une modernité incroyable. L'écran s'intègre parfaitement, on ne voit pas la différence avec d'origine. Navigation, Spotify, appels — tout fonctionne du premier coup.",
    initials: 'TR',
  },
];
---

<section id="temoignages" class="py-28 px-4" style="background: #06060C;">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <p class="font-body text-gold text-xs tracking-[0.4em] uppercase mb-5">Ce qu'ils en pensent</p>
      <h2 class="font-display text-5xl md:text-6xl lg:text-7xl text-warm-white">Avis clients</h2>
      <span class="section-rule mt-6"></span>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-5">
      {reviews.map((r, i) => (
        <blockquote class={`temoignage-card p-8 flex flex-col gap-6 reveal reveal-delay-${i + 1}`}>

          <!-- Stars -->
          <div class="flex gap-1" aria-label={`Note : ${r.rating} sur 5`}>
            {Array.from({ length: r.rating }).map(() => (
              <svg width="14" height="14" viewBox="0 0 14 14" fill="#C4962A" aria-hidden="true">
                <path d="M7 1l1.6 3.4 3.7.5-2.7 2.6.6 3.7L7 9.5l-3.2 1.7.6-3.7L1.7 4.9l3.7-.5Z"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <p class="font-body text-warm-white/70 text-sm leading-relaxed flex-1 italic">
            "{r.text}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-4 border-t border-gold/10 pt-6">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 font-body text-xs font-semibold text-ink"
              style="background: linear-gradient(135deg, #C4962A, #8B6914);"
              aria-hidden="true"
            >
              {r.initials}
            </div>
            <div>
              <p class="font-body text-warm-white text-sm font-medium">{r.name}</p>
              <p class="font-body text-warm-white/40 text-xs">{r.city} &nbsp;·&nbsp; {r.service}</p>
            </div>
          </div>

        </blockquote>
      ))}
    </div>

    <!-- Sous-ligne rassurante -->
    <p class="text-center font-body text-warm-white/30 text-xs tracking-wider mt-10 reveal">
      Témoignages recueillis directement auprès de nos clients — réels noms modifiés pour confidentialité
    </p>

  </div>
</section>
