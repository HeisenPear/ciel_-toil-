---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page introuvable (404)"
  description="La page demandée n’existe pas ou a été déplacée."
  path="/404"
  noindex
  hideFooterCta
>
  <Section tone="white" class="!py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-display text-6xl font-bold text-benne-500">404</p>
      <h1 class="mt-4 text-3xl text-ink-950 lg:text-4xl">Cette page a été enlevée</h1>
      <p class="mt-4 text-lg text-ink-600">
        Comme une benne pleine : le contenu que vous cherchez n’est plus à cette adresse.
      </p>

      <ul class="mx-auto mt-10 grid max-w-lg gap-3 text-left">
        {
          [
            { label: 'Savoir quelle benne choisir', href: '/nos-bennes' },
            { label: 'Consulter les tarifs', href: '/tarifs' },
            { label: 'Vérifier si nous livrons chez vous', href: '/zones-desservies' },
            { label: 'Demander un devis gratuit', href: '/contact' },
          ].map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-lg border border-ink-200 px-5 py-3.5 font-medium text-ink-800 transition-colors hover:border-benne-400 hover:bg-benne-50"
              >
                {item.label}
                <Icon name="arrow-right" size={18} class="text-ink-400" />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-10">
        <Button href="/" variant="dark" iconAfter="arrow-right">Retour à l’accueil</Button>
      </p>
    </div>
  </Section>
</BaseLayout>
