---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { CONTACT } from '../config/site';
---

<BaseLayout
  title="Demande envoyée — merci"
  description="Votre demande de devis a bien été transmise. Nous revenons vers vous sous 2 h ouvrées."
  path="/merci"
  noindex
  hideFooterCta
>
  <Section tone="white" class="!py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-tri-50 text-tri-600"
      >
        <Icon name="check" size={34} />
      </span>
      <h1 class="mt-6 text-3xl text-ink-950 lg:text-4xl">Votre demande est bien partie</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        Merci. Nous étudions votre besoin et revenons vers vous sous
        <strong>2 h ouvrées</strong> avec un tarif ferme et tout compris.
      </p>
      <p class="mt-3 text-ink-600">
        C’est urgent ? Appelez-nous directement au
        <a
          href={`tel:${CONTACT.phoneE164}`}
          class="font-semibold underline decoration-benne-400 decoration-2 underline-offset-4"
        >
          {CONTACT.phone}
        </a>.
      </p>

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" variant="dark" iconAfter="arrow-right">Retour à l’accueil</Button>
        <Button href="/blog" variant="outline">Lire nos guides pratiques</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
