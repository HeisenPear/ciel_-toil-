---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CallCard from '../components/CallCard.astro';
---

<BaseLayout
  title="Demande envoyée — merci"
  description="Votre demande de devis a bien été transmise. Nous revenons vers vous dans la journée ouvrée."
  path="/merci"
  noindex
  hideFooterCta
>
  <Section tone="white" class="!py-24">
    <div class="mx-auto max-w-2xl text-center">
      <span
        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-tri-50 text-tri-600"
      >
        <Icon name="check" size={34} />
      </span>
      <h1 class="mt-6 text-3xl text-ink-950 lg:text-4xl">Votre demande est bien partie</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-600">
        Merci. Nous étudions votre besoin et revenons vers vous
        <strong>dans la journée ouvrée</strong> avec un tarif ferme et tout compris.
      </p>

      <div class="mx-auto mt-10 max-w-md">
        <CallCard
          title="Vous voulez une réponse tout de suite ?"
          text="Un appel de deux minutes suffit à obtenir le prix et à caler une date de livraison."
        />
      </div>

      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" variant="dark" iconAfter="arrow-right">Retour à l’accueil</Button>
        <Button href="/blog" variant="outline">Lire nos guides pratiques</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
