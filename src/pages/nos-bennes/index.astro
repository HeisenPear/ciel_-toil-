---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import BenneCard from '../../components/BenneCard.astro';
import Faq from '../../components/Faq.astro';
import CallCard from '../../components/CallCard.astro';
import Icon from '../../components/Icon.astro';

import { BENNES } from '../../data/bennes';
import { faqByTopic } from '../../data/faq';
import { COMMUNES } from '../../data/communes';
import { SITE } from '../../config/site';
import { serviceSchema, faqSchema } from '../../lib/schema';

const breadcrumbs = [{ name: 'Nos bennes', url: '/nos-bennes' }];
const faq = faqByTopic('general', 4);

const schemas = [
  serviceSchema({
    name: 'Location de bennes de 1 à 30 m³',
    description:
      'Six formats de bennes à la location en Indre-et-Loire, du big bag 1 m³ à la benne 30 m³, avec dimensions, charge utile et tarifs.',
    url: `${SITE.url}/nos-bennes`,
    areaServed: COMMUNES.filter((c) => c.priority).map((c) => c.name),
    offers: BENNES.map((b) => ({
      name: b.name,
      description: b.punchline,
      url: `/nos-bennes/${b.slug}`,
    })),
  }),
  faqSchema(faq),
];
---

<BaseLayout
  title="Nos bennes : 6 formats de 1 à 30 m³ — dimensions et tarifs"
  description="Comparez nos 6 formats de bennes en Indre-et-Loire : dimensions, charge utile et déchets acceptés. Big bag 1 m³, bennes 8 à 30 m³. Devis gratuit par téléphone."
  path="/nos-bennes"
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <PageHeader
    breadcrumbs={breadcrumbs}
    eyebrow="Catalogue"
    title="Nos bennes à louer, de 1 à 30 m³"
    lead="Six formats couvrant tous les besoins, du sac de gravats en centre-ville de Tours à la benne 30 m³ pour un curage de local commercial."
    stats={[
      { label: 'Formats', value: '6' },
      { label: 'Volume', value: '1 à 30 m³' },
      { label: 'Charge utile', value: 'jusqu’à 9 t' },
    ]}
  />

  <Section tone="white" class="!pb-0 !pt-12">
    <AnswerBox question="Quelle benne choisir selon le type de déchet ?">
      <p>
        La règle est simple : <strong>plus le déchet est dense, plus la benne doit être petite</strong>.
        Une benne de 8 m³ atteint sa charge utile de 8 tonnes avec des gravats bien avant d’être
        pleine, alors qu’une benne de 30 m³ n’est adaptée qu’aux déchets légers et volumineux
        (cartons, mobilier, déchets verts) qui ne peuvent jamais dépasser le poids autorisé.
        En pratique : 8 m³ pour des gravats, 10 m³ pour un déménagement, 15 m³ pour une rénovation
        complète, 20 à 30 m³ pour un chantier professionnel ou un curage. Un doute ?
        Appelez-nous, nous dimensionnons avec vous et vous annonçons le tarif dans la foulée.
      </p>
    </AnswerBox>
  </Section>

  <Section tone="white">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {BENNES.map((benne) => <BenneCard benne={benne} />)}
    </div>
  </Section>

  <Section
    tone="muted"
    eyebrow="Comparatif"
    title="Tableau comparatif des bennes"
    lead="Toutes les caractéristiques réunies pour choisir en une minute."
  >
    <div class="overflow-x-auto rounded-card border border-ink-200 bg-white">
      <table class="w-full min-w-[46rem] border-collapse text-sm">
        <caption class="sr-only">
          Comparatif des formats de bennes : volume, dimensions, charge utile et usage type
        </caption>
        <thead>
          <tr class="bg-ink-950 text-left text-white">
            <th scope="col" class="px-4 py-3.5 font-semibold">Benne</th>
            <th scope="col" class="px-4 py-3.5 font-semibold">Dimensions (L × l × h)</th>
            <th scope="col" class="px-4 py-3.5 font-semibold">Charge utile</th>
            <th scope="col" class="px-4 py-3.5 font-semibold">Usage type</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-200">
          {
            BENNES.map((benne) => (
              <tr class="transition-colors hover:bg-benne-50/60">
                <th scope="row" class="px-4 py-4 text-left">
                  <a
                    href={`/nos-bennes/${benne.slug}`}
                    class="font-semibold text-ink-950 underline decoration-benne-400 decoration-2 underline-offset-4 hover:text-benne-700"
                  >
                    {benne.name}
                  </a>
                </th>
                <td class="px-4 py-4 text-ink-700">
                  {benne.dimensions.long} × {benne.dimensions.larg} × {benne.dimensions.haut} m
                </td>
                <td class="px-4 py-4 text-ink-700">{benne.charge} t</td>
                <td class="px-4 py-4 text-ink-700">{benne.usages[0]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 flex items-start gap-2 text-sm text-ink-500">
      <Icon name="warning" size={16} class="mt-0.5 shrink-0 text-benne-600" />
      Chaque location est établie sur devis : le prix dépend du volume, de la nature des déchets et
      de la commune de livraison. Un appel suffit à obtenir un tarif ferme et tout compris.
    </p>
  </Section>

  <Section tone="white" eyebrow="Questions fréquentes" title="Bien dimensionner sa benne" align="center">
    <Faq items={faq} />
    <div class="mx-auto mt-10 max-w-md">
      <CallCard
        title="Un doute sur le volume ?"
        text="Décrivez-nous le chantier en deux phrases : on vous dit quel format prendre, et on vous annonce le prix."
      />
    </div>
  </Section>
</BaseLayout>
