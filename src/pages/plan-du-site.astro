---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';

import { BENNES } from '../data/bennes';
import { communesByZone } from '../data/communes';

const breadcrumbs = [{ name: 'Plan du site', url: '/plan-du-site' }];
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const groupes = communesByZone();

const principales = [
  { label: 'Accueil', href: '/' },
  { label: 'Nos bennes', href: '/nos-bennes' },
  { label: 'Location de benne pour chantier', href: '/location-benne-chantier' },
  { label: 'Location de benne pour déménagement', href: '/location-benne-demenagement' },
  { label: 'Tarifs', href: '/tarifs' },
  { label: 'Déchets acceptés', href: '/dechets-acceptes' },
  { label: 'Zones desservies', href: '/zones-desservies' },
  { label: 'Questions fréquentes', href: '/faq' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact et devis', href: '/contact' },
];

const link = 'text-ink-700 hover:text-benne-700 underline decoration-ink-200 underline-offset-4 hover:decoration-benne-400';
---

<BaseLayout
  title="Plan du site"
  description="Toutes les pages du site : formats de bennes, services, tarifs, guide du tri, communes desservies en Indre-et-Loire et articles de blog."
  path="/plan-du-site"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    breadcrumbs={breadcrumbs}
    title="Plan du site"
    lead="L’ensemble des pages accessibles, organisées par rubrique."
  />

  <Section tone="white">
    <div class="grid gap-12 lg:grid-cols-3">
      <nav aria-labelledby="plan-principales">
        <h2 id="plan-principales" class="text-lg font-bold text-ink-950">Pages principales</h2>
        <ul class="mt-4 space-y-2.5">
          {principales.map((item) => <li><a href={item.href} class={link}>{item.label}</a></li>)}
        </ul>

        <h2 class="mt-10 text-lg font-bold text-ink-950">Nos bennes</h2>
        <ul class="mt-4 space-y-2.5">
          {
            BENNES.map((benne) => (
              <li>
                <a href={`/nos-bennes/${benne.slug}`} class={link}>
                  {benne.name}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-10 text-lg font-bold text-ink-950">Informations légales</h2>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/mentions-legales" class={link}>Mentions légales</a></li>
          <li>
            <a href="/politique-de-confidentialite" class={link}>Politique de confidentialité</a>
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="plan-communes" class="lg:col-span-2">
        <h2 id="plan-communes" class="text-lg font-bold text-ink-950">
          Location de benne par commune
        </h2>
        <div class="mt-4 space-y-7">
          {
            groupes.map((groupe) => (
              <div>
                <h3 class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-benne-700">
                  <Icon name="pin" size={15} />
                  {groupe.zone}
                </h3>
                <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                  {groupe.communes.map((commune) => (
                    <li>
                      <a href={`/location-benne/${commune.slug}`} class={link}>
                        {commune.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <h2 class="mt-10 text-lg font-bold text-ink-950">Articles du blog</h2>
        <ul class="mt-4 space-y-2.5">
          {
            posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class={link}>
                  {post.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Section>
</BaseLayout>
