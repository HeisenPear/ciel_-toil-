---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import AnswerBox from '../components/AnswerBox.astro';
import Faq from '../components/Faq.astro';
import CallCard from '../components/CallCard.astro';
import Icon from '../components/Icon.astro';

import { BENNES } from '../data/bennes';
import { faqByTopic } from '../data/faq';
import { COMMUNES } from '../data/communes';
import { SITE } from '../config/site';
import { serviceSchema, faqSchema } from '../lib/schema';

const breadcrumbs = [{ name: 'Tarifs', url: '/tarifs' }];
const faq = faqByTopic('tarifs');

const inclus = [
  'La livraison de la benne à l’adresse indiquée',
  '7 jours calendaires de mise à disposition',
  'L’enlèvement de la benne pleine',
  'Le transport jusqu’au centre de traitement agréé',
  'Le tri et le traitement des déchets, dans la limite de la charge utile',
  'Les plaques de répartition si le sol l’exige',
  'La signalisation temporaire en cas de dépose sur voirie',
];

/* Les trois variables du devis. C'est ce que le prospect a besoin de comprendre
   avant d'appeler — et ce qui explique qu'un prix ne puisse pas être affiché. */
const facteurs = [
  {
    icon: 'box' as const,
    title: 'Le volume',
    text:
      'De 1 à 30 m³. Le transport coûte la même chose quelle que soit la benne accrochée derrière ' +
      'le camion : une benne trop petite suivie d’une rotation revient toujours plus cher qu’un ' +
      'format correctement dimensionné dès le départ.',
  },
  {
    icon: 'recycle' as const,
    title: 'La nature des déchets',
    text:
      'C’est le poste le plus variable. Des gravats inertes purs sont concassés et réemployés : ' +
      'traitement peu coûteux. Un mélange non trié passe par une chaîne de tri, dont le coût est ' +
      'répercuté à la tonne. Trier à la source fait baisser la facture.',
  },
  {
    icon: 'pin' as const,
    title: 'La commune de livraison',
    text:
      'Tarif unique sur toute l’agglomération de Tours. Au-delà, nous regroupons les livraisons ' +
      'en tournées de secteur, ce qui limite fortement le surcoût vers Loches, Chinon, Amboise ' +
      'ou Château-Renault.',
  },
];

const schemas = [
  serviceSchema({
    name: 'Location de benne sur devis en Indre-et-Loire',
    description:
      'Chaque location de benne à Tours et en Indre-et-Loire est établie sur devis gratuit, ' +
      'selon le volume, la nature des déchets et la commune de livraison.',
    url: `${SITE.url}/tarifs`,
    areaServed: COMMUNES.filter((c) => c.priority).map((c) => c.name),
    offers: BENNES.map((b) => ({
      name: b.name,
      description: b.punchline,
      url: `/nos-bennes/${b.slug}`,
    })),
  }),
  faqSchema(faq),
];
---

<BaseLayout
  title="Tarifs location de benne à Tours — devis gratuit immédiat"
  description="Location de benne à Tours et en Indre-et-Loire : tarif sur devis gratuit, ferme et tout compris. Ce qui est inclus, ce qui fait varier le prix. Réponse immédiate par téléphone."
  path="/tarifs"
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <PageHeader
    breadcrumbs={breadcrumbs}
    eyebrow="Devis gratuit"
    title="Combien coûte une benne à Tours ?"
    lead="Un prix ferme et tout compris, annoncé pendant l’appel. Pas de grille figée : le tarif dépend de votre chantier, et c’est ce qui vous évite de payer pour ce dont vous n’avez pas besoin."
    stats={[
      { label: 'Devis', value: 'gratuit et immédiat' },
      { label: 'Location incluse', value: '7 jours' },
      { label: 'Sans', value: 'frais caché' },
    ]}
  />

  <Section tone="white" class="!pt-12">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-14">
      <div class="lg:col-span-2">
        <AnswerBox question="Comment est fixé le prix d’une location de benne ?">
          <p>
            Le tarif d’une benne est établi <strong>sur devis gratuit</strong>, parce qu’il dépend
            de trois éléments qu’un échange de deux minutes permet de fixer précisément : le
            <strong>volume</strong>, la <strong>nature des déchets</strong> et la
            <strong>commune de livraison</strong>. Le prix annoncé est ferme et couvre l’ensemble
            de la prestation — livraison, sept jours de mise à disposition, enlèvement et
            traitement des déchets. Rien ne s’ajoute après coup, hors dépassement de la charge
            utile ou redevance de voirie, tous deux annoncés à l’avance.
          </p>
        </AnswerBox>

        <div class="prose-fr mt-12 max-w-none">
          <h2>Pourquoi nous n’affichons pas de grille de prix</h2>
          <p>
            Parce qu’une grille affichée ment presque toujours par omission. Un tarif d’appel très
            bas exclut le plus souvent le traitement des déchets, facturé ensuite au réel à la
            tonne — et la facture finale n’a plus grand-chose à voir avec le prix annoncé.
          </p>
          <p>
            Nous préférons l’inverse : vous décrivez le chantier, nous annonçons un prix ferme qui
            couvre tout. C’est plus honnête, et c’est plus rapide qu’un formulaire.
          </p>
        </div>
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-28">
          <CallCard
            title="Votre prix en deux minutes"
            text="Volume, type de déchets, commune : trois informations suffisent pour obtenir un tarif ferme, tout compris."
          />
        </div>
      </div>
    </div>
  </Section>

  <Section
    tone="muted"
    eyebrow="Les trois variables"
    title="Ce qui fait varier le prix"
    lead="Comprendre ces trois leviers permet souvent de réduire la facture avant même d’appeler."
  >
    <ul class="grid gap-6 lg:grid-cols-3">
      {
        facteurs.map((facteur) => (
          <li class="rounded-card border border-ink-200 bg-white p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-benne-50 text-benne-700">
              <Icon name={facteur.icon} size={22} />
            </span>
            <h3 class="mt-4 text-lg font-bold text-ink-950">{facteur.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{facteur.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="white" eyebrow="Transparence" title="Ce que le devis couvre">
    <div class="grid gap-8 lg:grid-cols-2">
      <div class="rounded-card border border-tri-500/30 bg-tri-50 p-7">
        <h3 class="flex items-center gap-2.5 text-xl font-bold text-tri-700">
          <Icon name="check" size={22} />
          Compris dans le prix annoncé
        </h3>
        <ul class="mt-5 space-y-3">
          {
            inclus.map((item) => (
              <li class="flex items-start gap-2.5 text-ink-700">
                <Icon name="check" size={17} class="mt-0.5 shrink-0 text-tri-600" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-card border border-ink-200 bg-white p-7">
        <h3 class="flex items-center gap-2.5 text-xl font-bold text-ink-950">
          <Icon name="warning" size={22} class="text-benne-700" />
          Les seuls suppléments possibles
        </h3>
        <dl class="mt-5 divide-y divide-ink-200">
          <div class="py-4 first:pt-0">
            <dt class="font-semibold text-ink-900">Dépassement de la charge utile</dt>
            <dd class="mt-1 text-sm text-ink-600">
              Facturé à la tonne, sur la base de la pesée. S’évite en chargeant sous le niveau des
              ridelles — au-delà, la benne ne peut pas être bâchée et le camion ne peut pas circuler.
            </dd>
          </div>
          <div class="py-4">
            <dt class="font-semibold text-ink-900">Jours d’immobilisation supplémentaires</dt>
            <dd class="mt-1 text-sm text-ink-600">
              Sept jours sont inclus. Pour un chantier long, signalez-le dès l’appel : la formule au
              mois est plus économique. L’enlèvement anticipé, lui, est gratuit.
            </dd>
          </div>
          <div class="py-4">
            <dt class="font-semibold text-ink-900">Redevance d’occupation du domaine public</dt>
            <dd class="mt-1 text-sm text-ink-600">
              Fixée par la mairie, refacturée à l’euro près, sans frais de dossier. S’évite en
              déposant la benne sur un terrain privé.
            </dd>
          </div>
          <div class="py-4 last:pb-0">
            <dt class="font-semibold text-ink-900">Déchets interdits dans le chargement</dt>
            <dd class="mt-1 text-sm text-ink-600">
              Tri manuel facturé. Entièrement évitable :{' '}
              <a href="/dechets-acceptes" class="underline decoration-benne-400 underline-offset-2"
                >consultez le guide du tri</a
              >.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="muted" eyebrow="Questions fréquentes" title="Tarifs et facturation" align="center">
    <Faq items={faq} openFirst />
  </Section>
</BaseLayout>
